From 41f6a645068483470267271e1d09966ca3b9f413 Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Sat, 8 Aug 2026 20:07:53 +0200
Subject: [PATCH] fix(avfoundation): slew the media timebase instead of
 snapping on drift

mpv schedules video against its playback clock (the audio clock), while
the CMTimebase driving AVSampleBufferDisplayLayer presentation runs on
the CoreMedia host clock. On real hardware those clocks skew against
each other and the skew wanders, so the previous fixed-rate timebase let
the scheduling error float freely inside a +-20ms dead zone -- half a
frame at 24fps, deep into cadence-visible territory -- and corrected it
with a hard re-anchor: a >=20ms snap that repeats, skips, or drops
queued frames. That is the recurring micro-stutter of plezy#1776:
smooth after a fresh anchor (start, pause/play), degrading as drift
accumulates.

Replace the dead zone with a PI servo on the timebase rate: the
proportional term retires the measured error over a 2s horizon, the
integral term absorbs constant rate mismatch (clock skew, imperfectly
inferred playback rate) so the steady-state error converges to zero.
Rate offsets are capped at +-1.5% and only shift presentation deadlines
by microseconds per frame, so corrections are invisible. Hard
re-anchoring remains for genuine discontinuities (>50ms: broken
timestamps, playback-speed changes, audio-clock steps).

The servo core is freestanding C between markers so
scripts/test_avf_timebase_servo.sh can compile the production code into
a simulation: under constant 500ppm skew, wandering PLL skew, and
scheduling jitter it holds the error under 1ms with zero re-anchors
(legacy on the same input: 19ms error, 15 snaps/hour), while 80ms
audio-clock steps still snap exactly once and speed changes settle in a
bounded burst.

The 5s pacing diagnostics now also report rate updates, the applied
offset in ppm, and the window's drift peak.
---
 video/out/vo_avfoundation.m | 149 ++++++++++++++++++++++++++++++++---
 1 file changed, 144 insertions(+), 5 deletions(-)

diff --git a/video/out/vo_avfoundation.m b/video/out/vo_avfoundation.m
index 004537a..da752ee 100644
--- a/video/out/vo_avfoundation.m
+++ b/video/out/vo_avfoundation.m
@@ -155,6 +155,13 @@
     bool timebase_paused;
     bool playback_paused;
     double timebase_rate;
+    // Rate actually applied to the CMTimebase: timebase_rate plus the
+    // servo's drift-correction offset (see avf_servo_rate()).
+    double timebase_applied_rate;
+    int64_t last_rate_update_ns;
+    // PI servo state; zeroed on every hard anchor.
+    double servo_integral;
+    int64_t last_servo_eval_ns;
     int64_t anchor_media_pts_ns;
     int64_t anchor_present_host_ns;
 
@@ -164,6 +171,9 @@
     int64_t diag_wait_total_ns;
     int diag_drop_count;
     int diag_anchor_count;
+    int diag_rate_update_count;
+    // Peak |scheduling error| seen by the servo in the window.
+    int64_t diag_drift_peak_ns;
 
     // Track if OSD callback was invoked this frame
     bool osd_callback_invoked;
@@ -404,10 +414,100 @@ static void reset_media_timing(struct priv *p)
     // Keep a previously inferred rate across seeks/track switches; the
     // player's speed persists, so the first post-seek anchor starts correct.
     p->timebase_rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+    p->timebase_applied_rate = p->timebase_rate;
+    p->last_rate_update_ns = 0;
+    p->servo_integral = 0.0;
+    p->last_servo_eval_ns = 0;
     p->anchor_media_pts_ns = 0;
     p->anchor_present_host_ns = 0;
 }
 
+// --- avf sync servo core (host-testable; keep freestanding) ---
+//
+// mpv schedules video against its playback clock (normally the audio clock),
+// while the CMTimebase driving presentation runs on the CoreMedia host
+// clock. On real hardware those clocks skew against each other, and the
+// skew wanders (HDMI audio PLLs, route renegotiation, temperature). A
+// timebase that free-runs at a fixed rate therefore accumulates error, and
+// correcting it by re-anchoring is a visible >=20ms snap: queued samples
+// are suddenly early or late by the full error, so a frame repeats, skips,
+// or is dropped by the renderer outright (#1776's recurring stutter).
+//
+// Instead, sub-threshold error is absorbed by slewing the timebase rate: a
+// PI servo that retires the error over AVF_SERVO_HORIZON_NS. Rate offsets
+// this small only shift presentation deadlines by microseconds per frame,
+// so corrections are invisible; the integral term additionally absorbs any
+// constant rate mismatch (clock skew, an imperfectly inferred playback
+// rate), so the steady-state error converges to zero instead of parking at
+// mismatch * horizon. Hard re-anchoring remains only for genuine
+// discontinuities (broken timestamps, playback-speed changes, audio-clock
+// steps after route changes).
+
+// Errors above this are discontinuities: snap the anchor instead of chasing
+// them (at the slew cap, retiring 50ms would take >3s of visibly off-sync
+// video; mpv itself hard-resyncs A/V at this scale).
+#define AVF_DRIFT_SNAP_NS      MP_TIME_MS_TO_NS(50)
+// Retire the measured error over this long: the servo's time constant.
+#define AVF_SERVO_HORIZON_NS   MP_TIME_S_TO_NS(2)
+// Cap the correction offset at +-1.5% of nominal rate.
+#define AVF_SERVO_MAX_OFFSET   0.015
+// Skip timebase updates smaller than 100ppm; quantizes the steady state to
+// ~0.2ms of error rather than churning CoreMedia every frame.
+#define AVF_SERVO_MIN_DELTA    0.0001
+// Floor between consecutive rate updates; ~10x faster than the horizon, so
+// throttling never destabilizes the loop.
+#define AVF_SERVO_UPDATE_NS    MP_TIME_MS_TO_NS(200)
+// Integral time constant: 4x the horizon critically damps the loop
+// ((s + 1/(2T))^2 closed-loop poles); larger would absorb rate mismatch
+// slower, smaller would ring.
+#define AVF_SERVO_INTEGRAL_NS  (4 * AVF_SERVO_HORIZON_NS)
+// Ignore implausible integration steps (scheduling stalls, first sample).
+#define AVF_SERVO_MAX_DT_NS    MP_TIME_MS_TO_NS(500)
+
+// Decide how one frame's scheduling error feeds back into the timebase.
+// error_ns: frame media pts minus the timebase's projected media time at
+// the frame's presentation time (positive = timebase behind the schedule).
+// dt_ns: host time since the previous evaluation; *integral persists
+// between calls and must be zeroed on every hard anchor.
+// Returns the rate to run at; *snap requests a hard re-anchor, *update_rate
+// requests applying the returned rate to the timebase.
+static double avf_servo_rate(int64_t error_ns, double nominal_rate,
+                             double applied_rate, int64_t now_ns,
+                             int64_t last_update_ns, int64_t dt_ns,
+                             double *integral, bool *snap,
+                             bool *update_rate)
+{
+    *snap = false;
+    *update_rate = false;
+
+    if (llabs(error_ns) > AVF_DRIFT_SNAP_NS) {
+        *snap = true;
+        return nominal_rate;
+    }
+
+    double p_term = (double)error_ns / (double)AVF_SERVO_HORIZON_NS;
+    p_term = MPCLAMP(p_term, -AVF_SERVO_MAX_OFFSET, AVF_SERVO_MAX_OFFSET);
+
+    if (dt_ns > 0 && dt_ns <= AVF_SERVO_MAX_DT_NS) {
+        *integral += p_term * (double)dt_ns / (double)AVF_SERVO_INTEGRAL_NS;
+        *integral = MPCLAMP(*integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    }
+
+    double offset = MPCLAMP(p_term + *integral, -AVF_SERVO_MAX_OFFSET,
+                            AVF_SERVO_MAX_OFFSET);
+    double desired = nominal_rate * (1.0 + offset);
+
+    if (fabs(desired - applied_rate) <= AVF_SERVO_MIN_DELTA * nominal_rate)
+        return applied_rate;
+    if (last_update_ns && now_ns - last_update_ns < AVF_SERVO_UPDATE_NS)
+        return applied_rate;
+
+    *update_rate = true;
+    return desired;
+}
+// --- end avf sync servo core ---
+
 static void update_media_timebase_for_frame(struct vo *vo)
 {
     struct priv *p = vo->priv;
@@ -460,16 +560,41 @@ static void update_media_timebase_for_frame(struct vo *vo)
         p->playback_paused || rate_changed;
 
     if (!should_anchor) {
+        double applied = p->timebase_applied_rate > 0.0
+            ? p->timebase_applied_rate
+            : rate;
         int64_t timebase_ns = cm_time_to_ns(CMTimebaseGetTime(p->timebase));
         int64_t projected_ns = timebase_ns +
-            (int64_t)((double)(present_host_ns - now) * p->timebase_rate);
-        if (llabs(projected_ns - media_pts_ns) > MP_TIME_MS_TO_NS(20)) {
+            (int64_t)((double)(present_host_ns - now) * applied);
+        int64_t error_ns = media_pts_ns - projected_ns;
+
+        if (llabs(error_ns) > p->diag_drift_peak_ns)
+            p->diag_drift_peak_ns = llabs(error_ns);
+
+        int64_t dt_ns = p->last_servo_eval_ns
+            ? now - p->last_servo_eval_ns
+            : 0;
+        p->last_servo_eval_ns = now;
+
+        bool snap = false, update_rate = false;
+        double servo = avf_servo_rate(error_ns, rate, applied, now,
+                                      p->last_rate_update_ns, dt_ns,
+                                      &p->servo_integral,
+                                      &snap, &update_rate);
+        if (snap) {
             should_anchor = true;
+            MP_VERBOSE(vo, "Timebase %.1f ms off schedule; re-anchoring\n",
+                       error_ns / 1e6);
             // Accumulated drift means the anchored rate was off; adopt the
             // span-inferred rate (accurate by now) so the same drift does
             // not simply build up again.
             if (inferred_valid && span_host_ns >= MP_TIME_MS_TO_NS(100))
                 rate = inferred;
+        } else if (update_rate) {
+            CMTimebaseSetRate(p->timebase, servo);
+            p->timebase_applied_rate = servo;
+            p->last_rate_update_ns = now;
+            p->diag_rate_update_count++;
         }
     }
 
@@ -482,6 +607,10 @@ static void update_media_timebase_for_frame(struct vo *vo)
             MP_WARN(vo, "Failed to anchor AVFoundation media timebase: %d\n", (int)err);
         }
         p->timebase_rate = rate;
+        p->timebase_applied_rate = rate;
+        p->last_rate_update_ns = now;
+        p->servo_integral = 0.0;
+        p->last_servo_eval_ns = 0;
         p->timebase_anchor_valid = true;
         p->timebase_paused = p->playback_paused;
         p->anchor_media_pts_ns = media_pts_ns;
@@ -511,6 +640,7 @@ static void set_media_timebase_paused(struct vo *vo, bool paused)
             p->timebase, 0.0, media_time, source_time);
         if (err != noErr)
             MP_WARN(vo, "Failed to pause AVFoundation media timebase: %d\n", (int)err);
+        p->timebase_applied_rate = 0.0;
         p->timebase_paused = true;
         return;
     }
@@ -926,15 +1056,22 @@ static void report_presentation_diagnostics(struct vo *vo)
     if (now - p->diag_window_start_ns < MP_TIME_MS_TO_NS(5000))
         return;
 
-    if (p->diag_wait_count || p->diag_drop_count || p->diag_anchor_count) {
+    if (p->diag_wait_count || p->diag_drop_count || p->diag_anchor_count ||
+        p->diag_rate_update_count || p->diag_drift_peak_ns) {
+        double rate = p->timebase_rate > 0.0 ? p->timebase_rate : 1.0;
+        double offset_ppm =
+            (p->timebase_applied_rate / rate - 1.0) * 1e6;
         MP_VERBOSE(vo, "Presentation pacing over %.1fs: %d ready-waits "
-                   "(avg %.2f ms), %d deadline drops, %d timebase anchors\n",
+                   "(avg %.2f ms), %d deadline drops, %d timebase anchors, "
+                   "%d rate updates (now %+.0f ppm), drift peak %.2f ms\n",
                    (now - p->diag_window_start_ns) / 1e9,
                    p->diag_wait_count,
                    p->diag_wait_count
                        ? p->diag_wait_total_ns / 1e6 / p->diag_wait_count
                        : 0.0,
-                   p->diag_drop_count, p->diag_anchor_count);
+                   p->diag_drop_count, p->diag_anchor_count,
+                   p->diag_rate_update_count, offset_ppm,
+                   p->diag_drift_peak_ns / 1e6);
     }
 
     p->diag_window_start_ns = now;
@@ -942,6 +1079,8 @@ static void report_presentation_diagnostics(struct vo *vo)
     p->diag_wait_total_ns = 0;
     p->diag_drop_count = 0;
     p->diag_anchor_count = 0;
+    p->diag_rate_update_count = 0;
+    p->diag_drift_peak_ns = 0;
 }
 
 static void dispatch_main_sync_safe(dispatch_block_t block)
