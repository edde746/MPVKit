+static CMTime spdif_sample_duration(struct ao *ao, CMSampleBufferRef sample)
+{
+    struct priv *p = ao->priv;
+    CMTime duration = CMSampleBufferGetDuration(sample);
+    if (!CMTIME_IS_NUMERIC(duration) || CMTimeCompare(duration, kCMTimeZero) <= 0)
+        duration = CMTimeMake(p->spdif_frames_per_packet, p->spdif_rate);
+    return duration;
