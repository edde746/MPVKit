+// Retain an access unit we just handed to the renderer, trimming the oldest
+// entries once the window exceeds its byte budget.
+static void spdif_replay_cache_push(struct ao *ao, CMSampleBufferRef sample)
+{
+    struct priv *p = ao->priv;
