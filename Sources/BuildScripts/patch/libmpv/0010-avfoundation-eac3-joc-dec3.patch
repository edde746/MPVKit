+    if (!p->replay_cache)
+        return;
+    CFArrayAppendValue(p->replay_cache, sample);
+    p->replay_cache_bytes += CMSampleBufferGetTotalSampleSize(sample);
+    while (p->replay_cache_bytes > SPDIF_REPLAY_CACHE_BYTES &&
+           CFArrayGetCount(p->replay_cache) > 1) {
+        CMSampleBufferRef oldest =
+            (CMSampleBufferRef)CFArrayGetValueAtIndex(p->replay_cache, 0);
+        size_t oldest_size = CMSampleBufferGetTotalSampleSize(oldest);
+        p->replay_cache_bytes -= MPMIN(oldest_size, p->replay_cache_bytes);
+        CFArrayRemoveValueAtIndex(p->replay_cache, 0);
+    }
