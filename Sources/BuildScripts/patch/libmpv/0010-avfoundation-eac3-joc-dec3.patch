+// Re-enqueue every cached access unit that had not finished playing by
+// `now_ns`, at its ORIGINAL timestamp. The timebase keeps running, so the
+// timeline never moves and A/V sync is preserved; we simply put back the audio
+// the renderer threw away. Returns the PTS (ns) to resume normal feeding from,
+// or -1 when the cache cannot reach back to the playhead (in which case the
+// caller must not invent a timestamp for whatever mpv hands over next).
+static int64_t spdif_replay_from(struct ao *ao, int64_t now_ns)
+{
+    struct priv *p = ao->priv;
+
+    if (!p->replay_cache)
+        return -1;
+    CFIndex count = CFArrayGetCount(p->replay_cache);
+    if (count == 0)
+        return now_ns;  // nothing was queued ahead of the playhead
+
+    CMTime now = CMTimeFromNanoseconds(now_ns);
+    CMSampleBufferRef oldest = (CMSampleBufferRef)CFArrayGetValueAtIndex(p->replay_cache, 0);
+    CMTime oldest_pts = CMSampleBufferGetPresentationTimeStamp(oldest);
+    if (CMTIME_IS_NUMERIC(oldest_pts) && CMTimeCompare(oldest_pts, now) > 0) {
+        // The window was trimmed past the playhead; anything we replayed would
+        // leave a hole in front of it.
+        return -1;
+    }
+
+    int64_t resume = now_ns;
+    int replayed = 0;
+    for (CFIndex i = 0; i < count; i++) {
+        CMSampleBufferRef sample =
+            (CMSampleBufferRef)CFArrayGetValueAtIndex(p->replay_cache, i);
+        CMTime pts = CMSampleBufferGetPresentationTimeStamp(sample);
+        if (!CMTIME_IS_NUMERIC(pts))
+            continue;
+        CMTime end = CMTimeAdd(pts, spdif_sample_duration(ao, sample));
+        if (CMTimeCompare(end, now) <= 0)
+            continue;  // already played
+        [p->renderer enqueueSampleBuffer:sample];
+        replayed++;
+        resume = CMTimeGetNanoseconds(end);
+    }
+    MP_VERBOSE(ao, "replayed %d flushed access unit(s); resuming at %.3fs\n",
+               replayed, resume / 1e9);
+    return resume;
+}
